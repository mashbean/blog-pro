---
// 英文版首頁：站架英文、文章照列（絕大多數是中文，少數 EN 篇目
// 自帶 lang: en 標記）。詳見 src/lib/i18n.ts 開頭的取捨說明。
import BaseLayout from "../../layouts/BaseLayout.astro";
import HomeApp from "../../components/islands/HomeApp.tsx";
import { getPublishedReports } from "../../utils/reports";
import { reportToPost } from "../../lib/reports-to-posts";
import { UI } from "../../lib/i18n";
import { getTranslationMap, enReportPath } from "../../utils/translations";

const ui = UI.en;
const reports = await getPublishedReports();
// 有英文譯本的篇目，在英文站列表直接連到譯本並顯示英文標題；
// 沒有譯本的照列中文原文（見 src/lib/i18n.ts 的取捨）。
const translations = await getTranslationMap();
const posts = reports.map((r) => {
  const post = reportToPost(r);
  const t = translations.get(r.id);
  if (!t) return post;
  return {
    ...post,
    title: t.data.title,
    quote: t.data.description,
    href: enReportPath(r.id),
    lang: "en",
  };
});
---

<BaseLayout
  locale="en"
  altHref="/"
  fullTitle="Open Questions — asked by mashbean"
  description={ui.hero.tagline}
>
  <section class="hero hero--compact">
    <div>
      <h1 class="hero__title">{ui.hero.title}</h1>
      <p class="hero__sub">{ui.hero.tagline}</p>
    </div>
  </section>

  <!-- Keep article links in the initial HTML for non-JavaScript readers and agents. -->
  <HomeApp client:load posts={posts} locale="en" />
</BaseLayout>

<style>
  .hero__sub {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 700;
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    line-height: var(--leading-snug);
    color: var(--color-ink);
    margin: var(--space-3) 0 0;
    text-wrap: balance;
  }
  .hero--compact {
    margin-bottom: var(--space-5);
  }
  .hero--compact :global(.hero__title) {
    font-size: var(--text-3xl);
  }
</style>
