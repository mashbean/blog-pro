---
// 英文版首頁：站架英文、文章照列（絕大多數是中文，少數 EN 篇目
// 自帶 lang: en 標記）。詳見 src/lib/i18n.ts 開頭的取捨說明。
import BaseLayout from "../../layouts/BaseLayout.astro";
import HomeApp from "../../components/islands/HomeApp.tsx";
import { getPublishedReports } from "../../utils/reports";
import { reportToPost } from "../../lib/reports-to-posts";
import { TOPICS } from "../../lib/taxonomy";
import { UI } from "../../lib/i18n";

const ui = UI.en;
const reports = await getPublishedReports();
const posts = reports.map(reportToPost);

const essayCount = posts.length;
const topicCount = new Set(posts.map((p) => p.topic).filter(Boolean)).size;
const latest = posts.reduce((a, p) => (p.date > a ? p.date : a), "");
---

<BaseLayout
  locale="en"
  altHref="/"
  fullTitle="Open Questions — asked by mashbean"
  description={ui.hero.tagline}
>
  <section class="hero hero--compact">
    <div>
      <p class="hero__kicker">{ui.hero.kickerSuffix}</p>
      <h1 class="hero__title">{ui.hero.title}</h1>
      <p class="hero__sub">{ui.hero.tagline}</p>
    </div>
    <div class="hero__meta">
      <span><strong>{essayCount}</strong> {ui.hero.posts}</span>
      <span>{ui.hero.topics(topicCount, TOPICS.length)}</span>
      <span>{ui.hero.updated} {latest}</span>
    </div>
  </section>

  <HomeApp client:only="react" posts={posts} locale="en" />
</BaseLayout>

<style>
  .hero__sub {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 700;
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    line-height: var(--leading-snug);
    color: var(--color-ink);
    margin: var(--space-3) 0 0;
    text-wrap: balance;
  }
  .hero--compact {
    margin-bottom: var(--space-5);
  }
  .hero--compact :global(.hero__title) {
    font-size: var(--text-3xl);
  }
</style>
