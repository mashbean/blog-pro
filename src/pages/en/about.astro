---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { MAIN_SITE_URL } from "../../site.config";
---

<BaseLayout
  locale="en"
  altHref="/about/"
  fullTitle="About | Open Questions"
  description="An AI-powered research site: mashbean asks, AI investigates and writes."
>
  <article class="about">
    <p class="about__kicker">Colophon</p>
    <h1 class="about__title">About this site</h1>

    <div class="about__body report-prose">
      <p>
        <strong>Open Questions</strong> is an AI-powered research site.
        Every report starts from the same loop: mashbean (豆泥) poses a question,
        and an AI research pipeline investigates and writes the analysis.
      </p>

      <h2>How it works</h2>

      <p>
        Reports are generated through a multi-stage pipeline — research, drafting,
        adversarial challenge, and rewriting. Each report is labeled with the AI
        model and generation details, for full transparency.
      </p>

      <h2>Relationship to the main site</h2>

      <p>
        This site is an extension of <a href={MAIN_SITE_URL}>mashbean.net</a>.
        The main site collects mashbean's own writing; this one collects
        AI-generated research. Most essays here are written in Chinese —
        the few English ones carry an EN badge in the index.
      </p>

      <h2>Design system</h2>

      <p>
        The site's visual spec (type scale, spacing, color, components) is
        documented in a browsable <a href="/design-system/">design system</a>.
      </p>
    </div>
  </article>
</BaseLayout>

<style>
  .about {
    width: 80%;
    max-width: 680px;
    margin: 0 auto var(--space-10);
    position: relative;
    z-index: 2;
  }
  .about__kicker {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-ink-muted);
    margin: 0 0 var(--space-4);
  }
  .about__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1.08;
    letter-spacing: var(--tracking-tight);
    margin: 0 0 var(--space-6);
    text-wrap: balance;
  }
  .about__body {
    font-family: var(--font-display);
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--color-ink);
  }
  .about__body h2 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    margin-top: var(--space-7);
    margin-bottom: var(--space-3);
  }
  .about__body p { margin: 0 0 var(--space-5); text-wrap: pretty; }
  .about__body a { color: var(--color-ink); text-decoration: underline; text-underline-offset: 3px; }
  .about__body a:hover { text-decoration-thickness: 2px; }
  @media (max-width: 768px) {
    .about { width: 90%; }
    .about__body { font-size: 1rem; }
  }
</style>
