---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedReports } from "../../utils/reports";
import { TOPICS } from "../../lib/taxonomy";
import { withBase } from "../../utils/paths";

const reports = await getPublishedReports();

const byTopic = new Map<string, typeof reports>();
for (const r of reports) {
  const id = r.data.topic ?? "";
  if (!byTopic.has(id)) byTopic.set(id, []);
  byTopic.get(id)!.push(r);
}

const topics = TOPICS.map((t) => ({
  ...t,
  posts: byTopic.get(t.id) ?? [],
}));

const untopiced = byTopic.get("") ?? [];
---

<BaseLayout title="主題" description="依主題瀏覽全站文章。">
  <section class="topicshero">
    <p class="topicshero__kicker">Topics</p>
    <h1 class="topicshero__title">依主題瀏覽</h1>
    <p class="topicshero__sub">
      全站 {reports.length} 篇分成 {TOPICS.length} 個主題。想找特定的一篇，
      按 <kbd>⌘K</kbd> 直接全文搜尋。
    </p>
  </section>

  <div class="topicgrid">
    {topics.map((t) => (
      <a class="topiccard" href={withBase(`/topics/${t.id}/`)} data-topic={t.id}>
        <div class="topiccard__head">
          <h2 class="topiccard__title">{t.label}</h2>
          <span class="topiccard__n">{t.posts.length}</span>
        </div>
        <p class="topiccard__blurb">{t.blurb}</p>
        <ul class="topiccard__peek">
          {t.posts.slice(0, 3).map((p) => (
            <li>{p.data.title}</li>
          ))}
        </ul>
      </a>
    ))}
  </div>

  {untopiced.length > 0 && (
    <div class="topicgrid">
      <a class="topiccard" href={withBase("/tags/")}>
        <div class="topiccard__head">
          <h2 class="topiccard__title">未分類</h2>
          <span class="topiccard__n">{untopiced.length}</span>
        </div>
        <p class="topiccard__blurb">還沒指派主題的文章。</p>
      </a>
    </div>
  )}
</BaseLayout>

<style>
  .topicshero {
    width: var(--browse-w);
    margin: 0 auto var(--space-7);
  }
  .topicshero__kicker {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-ink-muted);
    margin: 0 0 var(--space-3);
  }
  .topicshero__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-3xl);
    line-height: var(--leading-tight);
    margin: 0;
  }
  .topicshero__sub {
    margin: var(--space-3) 0 0;
    max-width: 52ch;
    color: var(--color-ink-muted);
    line-height: var(--leading-relaxed);
  }
  .topicshero__sub kbd {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    border: 1px solid var(--color-rule-strong);
    border-radius: 3px;
    padding: 1px 5px;
    background: var(--color-surface);
  }

  .topicgrid {
    width: var(--browse-w);
    margin: 0 auto var(--space-8);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-4);
  }
  .topiccard {
    display: block;
    padding: var(--space-5);
    border: 1px solid oklch(0.86 0.055 var(--topic-h, 0) / var(--topic-a, 1));
    border-radius: var(--radius-lg);
    background: oklch(0.99 0.012 var(--topic-h, 0));
    text-decoration: none;
    color: var(--color-ink);
    transition: all var(--dur-fast, 160ms) var(--ease-standard, ease);
  }
  .topiccard:not([data-topic]) {
    border-color: var(--color-rule);
    background: var(--color-surface);
  }
  .topiccard:hover {
    border-color: oklch(0.58 0.14 var(--topic-h, 0));
    transform: translateY(-2px);
  }
  .topiccard__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .topiccard__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-lg);
    margin: 0;
    color: oklch(0.36 0.11 var(--topic-h, 0));
  }
  .topiccard:not([data-topic]) .topiccard__title { color: var(--color-ink) }
  .topiccard__n {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-ink-subtle);
    font-variant-numeric: tabular-nums;
  }
  .topiccard__blurb {
    margin: var(--space-2) 0 var(--space-4);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-ink-muted);
  }
  .topiccard__peek {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid oklch(0.88 0.04 var(--topic-h, 0));
    display: grid;
    gap: 2px;
    padding-top: var(--space-3);
  }
  .topiccard__peek li {
    font-size: var(--text-xs);
    color: var(--color-ink-subtle);
    line-height: var(--leading-snug);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
