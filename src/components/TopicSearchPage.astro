---
// 「主題搜尋」樞紐頁：主題格 + 標籤群 + 全文搜尋入口，zh / en 共用。
// 首頁的常駐 chips 退場後，這裡是瀏覽式探索的唯一據點。
import { getPublishedReports } from "../utils/reports";
import { TOPICS, TAG_CLUSTERS } from "../lib/taxonomy";
import { withBase } from "../utils/paths";
import type { Locale } from "../lib/i18n";

interface Props {
  locale?: Locale;
}
const { locale = "zh" } = Astro.props as Props;

const reports = await getPublishedReports();

const byTopic = new Map<string, typeof reports>();
for (const r of reports) {
  const id = r.data.topic ?? "";
  if (!byTopic.has(id)) byTopic.set(id, []);
  byTopic.get(id)!.push(r);
}
const topics = TOPICS.map((t) => ({ ...t, posts: byTopic.get(t.id) ?? [] }));

const tagCounts = new Map<string, number>();
for (const r of reports) {
  for (const t of r.data.tags ?? []) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
}
const clusters = TAG_CLUSTERS.map((c) => ({
  label: c.label,
  tags: c.tags.filter((t) => (tagCounts.get(t) ?? 0) > 0),
})).filter((c) => c.tags.length > 0);

const S = {
  zh: {
    kicker: "Topics · Tags · Search",
    title: "主題搜尋",
    sub: `全站 ${reports.length} 篇，${TOPICS.length} 個主題、${tagCounts.size} 個受控標籤。`,
    searchCta: "全文搜尋",
    searchHint: "標題、標籤、內文都能搜",
    topicsLabel: "主題",
    tagsLabel: "標籤",
  },
  en: {
    kicker: "Topics · Tags · Search",
    title: "Topics & Search",
    sub: `${reports.length} essays across ${TOPICS.length} topics and ${tagCounts.size} controlled tags.`,
    searchCta: "Full-text search",
    searchHint: "Searches titles, tags, and full text",
    topicsLabel: "Topics",
    tagsLabel: "Tags",
  },
}[locale];
---

<section class="topicshero">
  <p class="topicshero__kicker">{S.kicker}</p>
  <h1 class="topicshero__title">{S.title}</h1>
  <p class="topicshero__sub">{S.sub}</p>
  <button class="topicshero__search" type="button" data-search-open>
    <svg viewBox="0 0 20 20" aria-hidden="true">
      <circle cx="9" cy="9" r="6" fill="none" stroke="currentColor" stroke-width="1.7"></circle>
      <path d="M13.5 13.5 L17.5 17.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
    </svg>
    <span>{S.searchCta}</span>
    <kbd>⌘K</kbd>
    <em>{S.searchHint}</em>
  </button>
</section>

<section class="topicsection">
  <h2 class="topicsection__label">{S.topicsLabel}</h2>
  <div class="topicgrid">
    {topics.map((t) => (
      <a class="topiccard" href={withBase(`/topics/${t.id}/`)} data-topic={t.id}>
        <div class="topiccard__head">
          <h3 class="topiccard__title">{t.label}</h3>
          <span class="topiccard__n">{t.posts.length}</span>
        </div>
        <p class="topiccard__blurb">{t.blurb}</p>
        <ul class="topiccard__peek">
          {t.posts.slice(0, 3).map((p) => (
            <li>{p.data.title}</li>
          ))}
        </ul>
      </a>
    ))}
  </div>
</section>

<section class="topicsection">
  <h2 class="topicsection__label">{S.tagsLabel}</h2>
  {clusters.map((c) => (
    <div class="tagcluster">
      <h3 class="tagcluster__label">{c.label}</h3>
      <div class="tagcluster__chips">
        {c.tags.map((t) => (
          <a class="tagchip" href={withBase(`/tags/${encodeURIComponent(t)}/`)}>
            {t}<span>{tagCounts.get(t)}</span>
          </a>
        ))}
      </div>
    </div>
  ))}
</section>

<style>
  .topicshero {
    width: var(--browse-w);
    margin: 0 auto var(--space-7);
  }
  .topicshero__kicker {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-ink-muted);
    margin: 0 0 var(--space-3);
  }
  .topicshero__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-3xl);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    margin: 0;
  }
  .topicshero__sub {
    margin: var(--space-3) 0 0;
    max-width: 52ch;
    color: var(--color-ink-muted);
    line-height: var(--leading-relaxed);
  }
  /* 搜尋入口做成一條 ledger 式的大按鈕，跟首頁的篩選列同語言 */
  .topicshero__search {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    width: min(100%, 40rem);
    margin-top: var(--space-5);
    padding: var(--space-3) 2px;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--color-rule-strong);
    font-family: var(--font-sans);
    font-size: var(--text-base);
    color: var(--color-ink-muted);
    cursor: pointer;
    text-align: left;
    transition: all var(--dur-fast, 160ms) var(--ease-standard, ease);
  }
  .topicshero__search:hover {
    border-bottom-color: var(--color-ink);
    color: var(--color-ink);
  }
  .topicshero__search svg { width: 17px; height: 17px; flex: none }
  .topicshero__search kbd {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    border: 1px solid var(--color-rule);
    border-radius: 3px;
    padding: 0 5px;
    background: var(--color-surface);
  }
  .topicshero__search em {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-ink-subtle);
    margin-left: auto;
  }

  .topicsection {
    width: var(--browse-w);
    margin: 0 auto var(--space-8);
  }
  .topicsection__label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-ink-muted);
    margin: 0 0 var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--color-ink);
  }

  .topicgrid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-4);
  }
  /* 主題卡走黑白編輯風：hairline 外框、主題色只在左上一顆圓點 */
  .topiccard {
    display: block;
    padding: var(--space-5);
    border: 1px solid var(--color-rule);
    border-radius: 0;
    background: transparent;
    text-decoration: none;
    color: var(--color-ink);
    transition: border-color var(--dur-fast, 160ms) var(--ease-standard, ease);
    position: relative;
  }
  .topiccard[data-topic]::before {
    content: "";
    position: absolute;
    top: var(--space-5);
    right: var(--space-5);
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: oklch(0.62 0.14 var(--topic-h, 0));
  }
  .topiccard:hover { border-color: var(--color-ink) }
  .topiccard__head {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }
  .topiccard__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-lg);
    margin: 0;
  }
  .topiccard__n {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-ink-subtle);
    font-variant-numeric: tabular-nums;
  }
  .topiccard__blurb {
    margin: var(--space-2) 0 var(--space-4);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-ink-muted);
  }
  .topiccard__peek {
    list-style: none;
    margin: 0;
    padding: var(--space-3) 0 0;
    border-top: 1px solid var(--color-rule);
    display: grid;
    gap: 2px;
  }
  .topiccard__peek li {
    font-size: var(--text-xs);
    color: var(--color-ink-subtle);
    line-height: var(--leading-snug);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tagcluster { margin: 0 0 var(--space-5) }
  .tagcluster__label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-ink-subtle);
    margin: 0 0 var(--space-2);
    font-weight: 400;
  }
  .tagcluster__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }
  .tagchip {
    display: inline-flex;
    align-items: baseline;
    gap: 5px;
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    text-decoration: none;
    padding: 2px 0;
    transition: color var(--dur-fast, 160ms) var(--ease-standard, ease);
  }
  .tagchip::before { content: "#"; opacity: 0.5 }
  .tagchip:hover { color: var(--color-ink); text-decoration: underline; text-underline-offset: 3px }
  .tagchip span {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-ink-subtle);
    font-variant-numeric: tabular-nums;
  }
</style>
