---
import BaseHead from "../components/BaseHead.astro";
import Mesh from "../components/Mesh.astro";
import Guides from "../components/Guides.astro";
import Masthead from "../components/Masthead.astro";
import Iris from "../components/Iris.astro";
import Footer from "../components/Footer.astro";
import ReadingProgress from "../components/ReadingProgress.astro";
import TableOfContents from "../components/TableOfContents.astro";
import AiMetaBadge from "../components/AiMetaBadge.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import CitationTooltip from "../components/CitationTooltip.astro";
import SearchPalette from "../components/SearchPalette.astro";
import { formatDate } from "../utils/date";
import { readingTime, estimateReadingMinutes } from "../utils/reading-time";
import { getPublishedReports } from "../utils/reports";
import { relatedTo, seriesNeighbours } from "../lib/related";
import { topicOf, seriesMeta, sortTags } from "../lib/taxonomy";
import { withBase } from "../utils/paths";
import { getCollection } from "astro:content";
import { UI, type Locale } from "../lib/i18n";
import { getTranslationMap, enReportPath, zhReportPath } from "../utils/translations";
import "../styles/global.css";

interface Props {
  id: string;
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
  headings: { depth: number; slug: string; text: string }[];
  body: string;
  aiModel?: string;
  aiPrompt?: string;
  aiGeneratedDate?: Date;
  humanReviewed?: boolean;
  /** zh 是中文原文頁，en 是譯本頁；id 兩邊相同。 */
  locale?: Locale;
  translatedBy?: string;
  translatedDate?: Date;
}

const {
  id,
  title,
  description,
  pubDate,
  updatedDate,
  tags,
  headings,
  body,
  aiModel,
  aiPrompt,
  aiGeneratedDate,
  humanReviewed,
  locale = "zh",
  translatedBy,
  translatedDate,
} = Astro.props;

const isEn = locale === "en";
const ui = UI[locale];
const kicker = tags[0] ?? "Essay";
const readTime = readingTime(body, locale);

// 中英互切：譯本存在才有切換鈕。譯本頁一定有中文原文可切回去。
const translations = await getTranslationMap();
const hasTranslation = translations.has(id);
const zhHref = withBase(zhReportPath(id));
const enHref = withBase(enReportPath(id));
const altHref = isEn ? zhHref : hasTranslation ? enHref : undefined;
const showLangToggle = isEn || hasTranslation;

// 系列前後篇：在譯本頁上，鄰篇有譯本就連到譯本，沒有就連回中文。
const reportHref = (rid: string) =>
  withBase(isEn && translations.has(rid) ? enReportPath(rid) : zhReportPath(rid));
const reportTitle = (r: { id: string; data: { title: string } }) =>
  isEn ? translations.get(r.id)?.data.title ?? r.data.title : r.data.title;

const L = isEn
  ? {
      back: "← All essays",
      seriesNth: (n: number) => `Part ${n}`,
      seriesTotal: (n: number) => `${n} parts`,
      updated: "Updated",
      argmap: "Argument map",
      argmapSub: "Core thesis, pillars, causal chain, and boundary conditions, visualised",
      seriesNav: "Series navigation",
      seriesLine: (label: string, pos: number, total: number) => `${label} · ${pos} of ${total} by publication order`,
      prev: "← Previous",
      next: "Next →",
      related: "Related essays",
      minutes: (n: number) => `${n} min`,
      translationNote: translatedBy
        ? `English translation by ${translatedBy}. The Chinese original is authoritative.`
        : "English translation. The Chinese original is authoritative.",
      toggleZh: "中文原文",
      toggleEn: "English",
      toggleTitle: "Read the Chinese original",
    }
  : {
      back: "← All essays",
      seriesNth: (n: number) => `第 ${n} 篇`,
      seriesTotal: (n: number) => `共 ${n} 篇`,
      updated: "更新於",
      argmap: "論證地圖",
      argmapSub: "核心命題、支撐論點、因果鏈、邊界條件視覺化",
      seriesNav: "系列導覽",
      seriesLine: (label: string, pos: number, total: number) => `${label} · 依發表順序第 ${pos} / ${total} 篇`,
      prev: "← 前一篇",
      next: "下一篇 →",
      related: "相關文章",
      minutes: (n: number) => `${n} 分鐘`,
      translationNote: "",
      toggleZh: "中文",
      toggleEn: "English",
      toggleTitle: "Read this report in English",
    };
const ogImage = `og/${id}.png`;

// 此篇文章是否有對應的論證地圖（argmap）？
const argmaps = await getCollection("argmaps");
const matchedArgmap = argmaps.find((a) => a.data.slug === id);
const argmapHref = matchedArgmap ? `/argmaps/${matchedArgmap.id}/` : undefined;

const allReports = await getPublishedReports();
const self = allReports.find((r) => r.id === id);

// 相關文章走相似度，不是亂數（見 src/lib/related.ts）
const related = self ? relatedTo(self, allReports, 4) : [];
const seriesInfo = self?.data.series ? seriesMeta(self.data.series) : undefined;
const series = self ? seriesNeighbours(self, allReports, seriesInfo?.entry) : undefined;
const topic = topicOf(self?.data.topic);
const orderedTags = sortTags(tags);
---

<!doctype html>
<html lang={ui.htmlLang}>
  <head>
    <BaseHead title={title} description={description} ogImage={ogImage} />
    {showLangToggle && (
      <>
        <link rel="alternate" hreflang="zh-TW" href={new URL(zhHref, Astro.site).href} />
        <link rel="alternate" hreflang="en" href={new URL(enHref, Astro.site).href} />
        <link rel="alternate" hreflang="x-default" href={new URL(zhHref, Astro.site).href} />
      </>
    )}
  </head>
  <body>
    <Mesh />
    <Guides />
    <ReadingProgress />
    <Masthead locale={locale} altHref={altHref} />

    <article class="article">
      <a href={isEn ? "/en/" : "/"} class="article__back">{L.back}</a>

      {showLangToggle && (
        <div class="langtoggle" role="group" aria-label="Language / 語言">
          <a class:list={["langtoggle__opt", { "is-active": !isEn }]} href={zhHref} aria-current={!isEn ? "page" : undefined} hreflang="zh-TW" lang="zh-TW">{L.toggleZh}</a>
          <a class:list={["langtoggle__opt", { "is-active": isEn }]} href={enHref} aria-current={isEn ? "page" : undefined} hreflang="en" lang="en">{L.toggleEn}</a>
        </div>
      )}

      <p class="article__kicker">
        {topic ? (
          <a class="article__topic" href={withBase(`/topics/${topic.id}/`)} data-topic={topic.id}>
            {topic.label}
          </a>
        ) : kicker}
        {seriesInfo && series && series.total > 1 && (
          <span class="article__seriesbadge">
            {isEn ? seriesInfo.labelEn ?? seriesInfo.label : seriesInfo.label}
            {/* 顯示作者自己的篇號，沒標號的就不編——不拿發表位次冒充篇號 */}
            <em>{self?.data.seriesOrder ? L.seriesNth(self.data.seriesOrder) : L.seriesTotal(series.total)}</em>
          </span>
        )}
      </p>
      <h1 class="article__title">{title}</h1>
      <p class="article__lede">“{description}”</p>

      <div class="article__meta">
        <span>
          <strong>{aiModel ?? "AI Research Pipeline"}</strong>
        </span>
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate, locale)}</time>
        {updatedDate && <span>· {L.updated} {formatDate(updatedDate, locale)}</span>}
        <span>{readTime}</span>
        <span style="margin-left:auto">#{id.split("/").pop()}</span>
      </div>

      {orderedTags.length > 0 && (
        <div class="article__tags">
          {orderedTags.map((tag) => (
            <a class="article__tag" href={withBase(`/tags/${encodeURIComponent(tag)}/`)}>
              {tag}
            </a>
          ))}
        </div>
      )}

      <AiMetaBadge
        aiModel={aiModel}
        aiPrompt={aiPrompt}
        aiGeneratedDate={aiGeneratedDate}
        humanReviewed={humanReviewed}
      />

      {isEn && (
        <p class="article__translation">
          {L.translationNote}
          {translatedDate && <span> · {formatDate(translatedDate, locale)}</span>}
          {" "}<a href={zhHref} hreflang="zh-TW">{L.toggleZh} →</a>
        </p>
      )}

      {argmapHref && (
        <a class="article__argmap-link" href={argmapHref}>
          <span class="article__argmap-icon">◇</span>
          <span class="article__argmap-text">
            <strong>{L.argmap}</strong>
            <em>{L.argmapSub}</em>
          </span>
          <span class="article__argmap-arrow">→</span>
        </a>
      )}

      <div class="article__body report-prose">
        <slot />
      </div>

      <aside class="article__sidebar">
        <TableOfContents headings={headings} />
      </aside>
    </article>

    {series && (series.prev || series.next) && (
      <nav class="seriesnav" aria-label={L.seriesNav}>
        <p class="seriesnav__label">
          {L.seriesLine((isEn ? seriesInfo?.labelEn : undefined) ?? seriesInfo?.label ?? (isEn ? "Series" : "系列"), series.position, series.total)}
        </p>
        <div class="seriesnav__pair">
          {series.prev ? (
            <a class="seriesnav__item" href={reportHref(series.prev.id)}>
              <span class="seriesnav__dir">{L.prev}</span>
              <span class="seriesnav__t">{reportTitle(series.prev)}</span>
            </a>
          ) : <span />}
          {series.next ? (
            <a class="seriesnav__item seriesnav__item--next" href={reportHref(series.next.id)}>
              <span class="seriesnav__dir">{L.next}</span>
              <span class="seriesnav__t">{reportTitle(series.next)}</span>
            </a>
          ) : <span />}
        </div>
      </nav>
    )}

    {related.length > 0 && (
      <section class="related">
        <div class="related__head">
          <span class="related__label">{L.related}</span>
        </div>
        <ul class="related__list">
          {related.map(({ report: r, reason }) => (
            <li>
              <a class="related__row" href={reportHref(r.id)}>
                <time class="related__date" datetime={r.data.pubDate.toISOString()}>
                  {r.data.pubDate.toISOString().slice(0, 10)}
                </time>
                <span class="related__t">{reportTitle(r)}</span>
                <span class="related__why">{reason}</span>
                <span class="related__mins">
                  {L.minutes(estimateReadingMinutes((r.body ?? "").toString()))}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <Footer />
    <SearchPalette />
    <Iris />
    <ScrollReveal />
    <CitationTooltip />

    <style>
      /* ---- 中英一鍵切換 ---- */
      .langtoggle {
        display: inline-flex;
        margin: 0 0 var(--space-4);
        border: 1px solid var(--color-rule-strong);
        border-radius: var(--radius-pill);
        overflow: hidden;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: var(--tracking-wide);
      }
      .langtoggle__opt {
        padding: 4px 12px;
        color: var(--color-ink-muted);
        text-decoration: none;
        transition: all var(--dur-fast) var(--ease-standard);
      }
      .langtoggle__opt + .langtoggle__opt { border-left: 1px solid var(--color-rule-strong); }
      .langtoggle__opt:hover { color: var(--color-ink); }
      .langtoggle__opt.is-active {
        background: var(--color-ink);
        color: var(--color-canvas);
        pointer-events: none;
      }
      .article__translation {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-ink-muted);
        margin: 0 0 var(--space-6);
        padding: var(--space-3) var(--space-4);
        border-left: 3px solid var(--color-rule-strong);
        background: var(--color-surface);
      }
      .article__translation a { color: var(--color-ink); }

      .article__kicker {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        flex-wrap: wrap;
      }
      .article__topic {
        color: oklch(0.46 0.12 var(--topic-h, 0));
        text-decoration: none;
        border-bottom: 1px solid currentColor;
      }
      .article__seriesbadge {
        display: inline-flex;
        align-items: baseline;
        gap: 6px;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-ink-muted);
        border: 1px solid var(--color-rule);
        border-radius: var(--radius-pill);
        padding: 2px 10px;
        text-transform: none;
        letter-spacing: 0;
      }
      .article__seriesbadge em {
        font-style: normal;
        color: var(--color-ink-subtle);
        font-variant-numeric: tabular-nums;
      }

      /* ---- 系列前後篇 ---- */
      .seriesnav {
        width: min(960px, calc(100% - 2 * var(--space-5)));
        margin: 0 auto var(--space-7);
      }
      .seriesnav__label {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        text-transform: uppercase;
        letter-spacing: var(--tracking-wide);
        color: var(--color-ink-subtle);
        margin: 0 0 var(--space-3);
      }
      .seriesnav__pair {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-4);
      }
      .seriesnav__item {
        display: grid;
        gap: var(--space-2);
        padding: var(--space-4);
        border: 1px solid var(--color-rule-strong);
        border-radius: var(--radius-md);
        background: var(--color-surface);
        text-decoration: none;
        color: var(--color-ink);
        transition: all var(--dur-fast) var(--ease-standard);
      }
      .seriesnav__item:hover { border-color: var(--color-ink); transform: translateY(-2px) }
      .seriesnav__item--next { text-align: right }
      .seriesnav__dir {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-ink-subtle);
      }
      .seriesnav__t {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: var(--text-sm);
        line-height: var(--leading-snug);
      }
      @media (max-width: 720px) {
        .seriesnav__pair { grid-template-columns: 1fr }
        .seriesnav__item--next { text-align: left }
      }

      /* ---- 相關文章 ---- */
      .related__list {
        list-style: none;
        margin: 0;
        padding: 0;
        border-top: 1px solid var(--color-rule);
      }
      .related__row {
        display: grid;
        grid-template-columns: 6.5rem 1fr auto auto;
        gap: var(--space-4);
        align-items: baseline;
        padding: var(--space-3) 0;
        border-bottom: 1px solid var(--color-rule);
        text-decoration: none;
        color: var(--color-ink);
      }
      .related__row:hover .related__t {
        text-decoration: underline;
        text-underline-offset: 3px;
      }
      .related__date,
      .related__why,
      .related__mins {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-ink-subtle);
        white-space: nowrap;
      }
      .related__t {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: var(--text-sm);
        line-height: var(--leading-snug);
      }
      @media (max-width: 720px) {
        .related__row { grid-template-columns: 1fr; gap: var(--space-1) }
        .related__why { display: none }
      }

      .article__tags {
        display: flex;
        gap: var(--space-2);
        flex-wrap: wrap;
        margin: 0 0 var(--space-6);
      }
      .article__tag {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-ink-muted);
        text-decoration: none;
        padding: 2px 10px;
        border-radius: var(--radius-pill);
        border: 1px solid var(--color-rule);
        transition: all var(--dur-fast) var(--ease-standard);
      }
      .article__tag:hover {
        color: var(--color-ink);
        border-color: var(--color-ink);
      }
      .article__argmap-link {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        margin: var(--space-4) 0 var(--space-6);
        padding: var(--space-3) var(--space-4);
        background: var(--color-bg-muted);
        border: 1px solid var(--color-border);
        border-left: 3px solid var(--color-accent);
        border-radius: var(--radius-sm, 4px);
        text-decoration: none;
        color: var(--color-text);
        transition:
          border-color 0.2s ease,
          background 0.2s ease,
          transform 0.2s ease;
      }
      .article__argmap-link:hover {
        border-color: var(--color-accent);
        background: var(--color-accent-soft);
        transform: translateX(2px);
      }
      .article__argmap-icon {
        font-size: 1.4rem;
        color: var(--color-accent);
        line-height: 1;
      }
      .article__argmap-text {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
      }
      .article__argmap-text strong {
        font-family: var(--font-serif);
        font-size: 0.95rem;
        font-weight: 600;
        letter-spacing: 0.02em;
      }
      .article__argmap-text em {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        font-style: normal;
        color: var(--color-text-muted);
        letter-spacing: 0.04em;
      }
      .article__argmap-arrow {
        font-family: var(--font-mono);
        color: var(--color-text-muted);
        font-size: 1.1rem;
      }
      .article__argmap-link:hover .article__argmap-arrow {
        color: var(--color-accent);
      }
      .article__sidebar {
        display: none;
      }
      @media (min-width: 1100px) {
        .article {
          display: grid;
          grid-template-columns: minmax(0, 1fr) 220px;
          gap: var(--space-7);
          max-width: 960px;
          align-items: start;
        }
        .article > *:not(.article__sidebar) {
          grid-column: 1;
        }
        .article__sidebar {
          display: block;
          grid-column: 2;
          grid-row: 1 / span 8;
          position: sticky;
          top: var(--space-6);
        }
      }
    </style>
  </body>
</html>
