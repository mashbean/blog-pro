---
import BaseHead from "../components/BaseHead.astro";
import Mesh from "../components/Mesh.astro";
import Guides from "../components/Guides.astro";
import Masthead from "../components/Masthead.astro";
import Iris from "../components/Iris.astro";
import Footer from "../components/Footer.astro";
import ReadingProgress from "../components/ReadingProgress.astro";
import TableOfContents from "../components/TableOfContents.astro";
import AiMetaBadge from "../components/AiMetaBadge.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import CitationTooltip from "../components/CitationTooltip.astro";
import SearchPalette from "../components/SearchPalette.astro";
import { formatDate } from "../utils/date";
import { readingTime, estimateReadingMinutes } from "../utils/reading-time";
import { getPublishedReports } from "../utils/reports";
import { relatedTo, seriesNeighbours } from "../lib/related";
import { topicOf, seriesMeta, sortTags } from "../lib/taxonomy";
import { withBase } from "../utils/paths";
import { getCollection } from "astro:content";
import "../styles/global.css";

interface Props {
  id: string;
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
  headings: { depth: number; slug: string; text: string }[];
  body: string;
  aiModel?: string;
  aiPrompt?: string;
  aiGeneratedDate?: Date;
  humanReviewed?: boolean;
}

const {
  id,
  title,
  description,
  pubDate,
  updatedDate,
  tags,
  headings,
  body,
  aiModel,
  aiPrompt,
  aiGeneratedDate,
  humanReviewed,
} = Astro.props;

const kicker = tags[0] ?? "Essay";
const readTime = readingTime(body);
const ogImage = `og/${id}.png`;

// 此篇文章是否有對應的論證地圖（argmap）？
const argmaps = await getCollection("argmaps");
const matchedArgmap = argmaps.find((a) => a.data.slug === id);
const argmapHref = matchedArgmap ? `/argmaps/${matchedArgmap.id}/` : undefined;

const allReports = await getPublishedReports();
const self = allReports.find((r) => r.id === id);

// 相關文章走相似度，不是亂數（見 src/lib/related.ts）
const related = self ? relatedTo(self, allReports, 4) : [];
const seriesInfo = self?.data.series ? seriesMeta(self.data.series) : undefined;
const series = self ? seriesNeighbours(self, allReports, seriesInfo?.entry) : undefined;
const topic = topicOf(self?.data.topic);
const orderedTags = sortTags(tags);
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <BaseHead title={title} description={description} ogImage={ogImage} />
  </head>
  <body>
    <Mesh />
    <Guides />
    <ReadingProgress />
    <Masthead />

    <article class="article">
      <a href="/" class="article__back">← All essays</a>

      <p class="article__kicker">
        {topic ? (
          <a class="article__topic" href={withBase(`/topics/${topic.id}/`)} data-topic={topic.id}>
            {topic.label}
          </a>
        ) : kicker}
        {seriesInfo && series && series.total > 1 && (
          <span class="article__seriesbadge">
            {seriesInfo.label}
            {/* 顯示作者自己的篇號，沒標號的就不編——不拿發表位次冒充篇號 */}
            <em>{self?.data.seriesOrder ? `第 ${self.data.seriesOrder} 篇` : `共 ${series.total} 篇`}</em>
          </span>
        )}
      </p>
      <h1 class="article__title">{title}</h1>
      <p class="article__lede">“{description}”</p>

      <div class="article__meta">
        <span>
          <strong>{aiModel ?? "AI Research Pipeline"}</strong>
        </span>
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {updatedDate && <span>· 更新於 {formatDate(updatedDate)}</span>}
        <span>{readTime}</span>
        <span style="margin-left:auto">#{id.split("/").pop()}</span>
      </div>

      {orderedTags.length > 0 && (
        <div class="article__tags">
          {orderedTags.map((tag) => (
            <a class="article__tag" href={withBase(`/tags/${encodeURIComponent(tag)}/`)}>
              {tag}
            </a>
          ))}
        </div>
      )}

      <AiMetaBadge
        aiModel={aiModel}
        aiPrompt={aiPrompt}
        aiGeneratedDate={aiGeneratedDate}
        humanReviewed={humanReviewed}
      />

      {argmapHref && (
        <a class="article__argmap-link" href={argmapHref}>
          <span class="article__argmap-icon">◇</span>
          <span class="article__argmap-text">
            <strong>論證地圖</strong>
            <em>核心命題、支撐論點、因果鏈、邊界條件視覺化</em>
          </span>
          <span class="article__argmap-arrow">→</span>
        </a>
      )}

      <div class="article__body report-prose">
        <slot />
      </div>

      <aside class="article__sidebar">
        <TableOfContents headings={headings} />
      </aside>
    </article>

    {series && (series.prev || series.next) && (
      <nav class="seriesnav" aria-label="系列導覽">
        <p class="seriesnav__label">
          {seriesInfo?.label ?? "系列"} · 依發表順序第 {series.position} / {series.total} 篇
        </p>
        <div class="seriesnav__pair">
          {series.prev ? (
            <a class="seriesnav__item" href={withBase(`/reports/${series.prev.id}/`)}>
              <span class="seriesnav__dir">← 前一篇</span>
              <span class="seriesnav__t">{series.prev.data.title}</span>
            </a>
          ) : <span />}
          {series.next ? (
            <a class="seriesnav__item seriesnav__item--next" href={withBase(`/reports/${series.next.id}/`)}>
              <span class="seriesnav__dir">下一篇 →</span>
              <span class="seriesnav__t">{series.next.data.title}</span>
            </a>
          ) : <span />}
        </div>
      </nav>
    )}

    {related.length > 0 && (
      <section class="related">
        <div class="related__head">
          <span class="related__label">相關文章</span>
        </div>
        <ul class="related__list">
          {related.map(({ report: r, reason }) => (
            <li>
              <a class="related__row" href={withBase(`/reports/${r.id}/`)}>
                <time class="related__date" datetime={r.data.pubDate.toISOString()}>
                  {r.data.pubDate.toISOString().slice(0, 10)}
                </time>
                <span class="related__t">{r.data.title}</span>
                <span class="related__why">{reason}</span>
                <span class="related__mins">
                  {estimateReadingMinutes((r.body ?? "").toString())} 分鐘
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <Footer />
    <SearchPalette />
    <Iris />
    <ScrollReveal />
    <CitationTooltip />

    <style>
      .article__kicker {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        flex-wrap: wrap;
      }
      .article__topic {
        color: oklch(0.46 0.12 var(--topic-h, 0));
        text-decoration: none;
        border-bottom: 1px solid currentColor;
      }
      .article__seriesbadge {
        display: inline-flex;
        align-items: baseline;
        gap: 6px;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-ink-muted);
        border: 1px solid var(--color-rule);
        border-radius: var(--radius-pill);
        padding: 2px 10px;
        text-transform: none;
        letter-spacing: 0;
      }
      .article__seriesbadge em {
        font-style: normal;
        color: var(--color-ink-subtle);
        font-variant-numeric: tabular-nums;
      }

      /* ---- 系列前後篇 ---- */
      .seriesnav {
        width: min(960px, calc(100% - 2 * var(--space-5)));
        margin: 0 auto var(--space-7);
      }
      .seriesnav__label {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        text-transform: uppercase;
        letter-spacing: var(--tracking-wide);
        color: var(--color-ink-subtle);
        margin: 0 0 var(--space-3);
      }
      .seriesnav__pair {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-4);
      }
      .seriesnav__item {
        display: grid;
        gap: var(--space-2);
        padding: var(--space-4);
        border: 1px solid var(--color-rule-strong);
        border-radius: var(--radius-md);
        background: var(--color-surface);
        text-decoration: none;
        color: var(--color-ink);
        transition: all var(--dur-fast) var(--ease-standard);
      }
      .seriesnav__item:hover { border-color: var(--color-ink); transform: translateY(-2px) }
      .seriesnav__item--next { text-align: right }
      .seriesnav__dir {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-ink-subtle);
      }
      .seriesnav__t {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: var(--text-sm);
        line-height: var(--leading-snug);
      }
      @media (max-width: 720px) {
        .seriesnav__pair { grid-template-columns: 1fr }
        .seriesnav__item--next { text-align: left }
      }

      /* ---- 相關文章 ---- */
      .related__list {
        list-style: none;
        margin: 0;
        padding: 0;
        border-top: 1px solid var(--color-rule);
      }
      .related__row {
        display: grid;
        grid-template-columns: 6.5rem 1fr auto auto;
        gap: var(--space-4);
        align-items: baseline;
        padding: var(--space-3) 0;
        border-bottom: 1px solid var(--color-rule);
        text-decoration: none;
        color: var(--color-ink);
      }
      .related__row:hover .related__t {
        text-decoration: underline;
        text-underline-offset: 3px;
      }
      .related__date,
      .related__why,
      .related__mins {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-ink-subtle);
        white-space: nowrap;
      }
      .related__t {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: var(--text-sm);
        line-height: var(--leading-snug);
      }
      @media (max-width: 720px) {
        .related__row { grid-template-columns: 1fr; gap: var(--space-1) }
        .related__why { display: none }
      }

      .article__tags {
        display: flex;
        gap: var(--space-2);
        flex-wrap: wrap;
        margin: 0 0 var(--space-6);
      }
      .article__tag {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-ink-muted);
        text-decoration: none;
        padding: 2px 10px;
        border-radius: var(--radius-pill);
        border: 1px solid var(--color-rule);
        transition: all var(--dur-fast) var(--ease-standard);
      }
      .article__tag:hover {
        color: var(--color-ink);
        border-color: var(--color-ink);
      }
      .article__argmap-link {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        margin: var(--space-4) 0 var(--space-6);
        padding: var(--space-3) var(--space-4);
        background: var(--color-bg-muted);
        border: 1px solid var(--color-border);
        border-left: 3px solid var(--color-accent);
        border-radius: var(--radius-sm, 4px);
        text-decoration: none;
        color: var(--color-text);
        transition:
          border-color 0.2s ease,
          background 0.2s ease,
          transform 0.2s ease;
      }
      .article__argmap-link:hover {
        border-color: var(--color-accent);
        background: var(--color-accent-soft);
        transform: translateX(2px);
      }
      .article__argmap-icon {
        font-size: 1.4rem;
        color: var(--color-accent);
        line-height: 1;
      }
      .article__argmap-text {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
      }
      .article__argmap-text strong {
        font-family: var(--font-serif);
        font-size: 0.95rem;
        font-weight: 600;
        letter-spacing: 0.02em;
      }
      .article__argmap-text em {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        font-style: normal;
        color: var(--color-text-muted);
        letter-spacing: 0.04em;
      }
      .article__argmap-arrow {
        font-family: var(--font-mono);
        color: var(--color-text-muted);
        font-size: 1.1rem;
      }
      .article__argmap-link:hover .article__argmap-arrow {
        color: var(--color-accent);
      }
      .article__sidebar {
        display: none;
      }
      @media (min-width: 1100px) {
        .article {
          display: grid;
          grid-template-columns: minmax(0, 1fr) 220px;
          gap: var(--space-7);
          max-width: 960px;
          align-items: start;
        }
        .article > *:not(.article__sidebar) {
          grid-column: 1;
        }
        .article__sidebar {
          display: block;
          grid-column: 2;
          grid-row: 1 / span 8;
          position: sticky;
          top: var(--space-6);
        }
      }
    </style>
  </body>
</html>
