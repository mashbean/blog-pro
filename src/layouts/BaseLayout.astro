---
import BaseHead from "../components/BaseHead.astro";
import Mesh from "../components/Mesh.astro";
import Guides from "../components/Guides.astro";
import Masthead from "../components/Masthead.astro";
import Iris from "../components/Iris.astro";
import Footer from "../components/Footer.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import SearchPalette from "../components/SearchPalette.astro";
import { UI, type Locale } from "../lib/i18n";
import "../styles/global.css";

interface Props {
  title?: string;
  fullTitle?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  /** Hide the default masthead when the page renders its own chrome. */
  bareChrome?: boolean;
  /** Hide the global mesh background on pages that want a clean canvas. */
  noMesh?: boolean;
  locale?: Locale;
  /** 語言切換要落到對方語言的哪一頁；預設對方首頁。 */
  altHref?: string;
}

const {
  title, fullTitle, description, ogImage, noindex,
  bareChrome = false, noMesh = false, locale = "zh", altHref,
} = Astro.props;
---

<!doctype html>
<html lang={UI[locale].htmlLang}>
  <head>
    <BaseHead title={title} fullTitle={fullTitle} description={description} ogImage={ogImage} noindex={noindex} />
  </head>
  <body>
    {!noMesh && <Mesh />}
    <Guides />
    {!bareChrome && <Masthead locale={locale} altHref={altHref} />}
    <slot />
    <Footer locale={locale} />
    <SearchPalette locale={locale} />
    <Iris />
    <ScrollReveal />
  </body>
</html>
